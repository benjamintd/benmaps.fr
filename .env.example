# Browser-visible credentials: restrict each to your production + preview domains.
VITE_PROTOMAPS_KEY=
VITE_MAPBOX_TOKEN=
# Optional: use your own Protomaps v4 archive instead of the hosted tile API.
# Must support CORS and HTTP Range requests.
VITE_PMTILES_URL=
# Optional overrides for the hosted Clair renderer and Paris landmark catalogue.
VITE_CLAIR_3D_URL=
VITE_OPEN_LANDMARKS_CATALOGUE_URL=
