{
  "name": "benmaps",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json *.md *.html",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md *.html",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "6.9.0",
    "pmtiles": "^4.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
